<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MoagilDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#0066DD</item>
        <item name="android:textColorPrimary">#1C1C1E</item>
        <item name="android:textColorSecondary">#636770</item>
        <item name="android:windowMinWidthMajor">72%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:textAppearanceLarge">@style/MoagilDialogTitle</item>
        <item name="android:textAppearanceMedium">@style/MoagilDialogText</item>
        <item name="android:textAppearanceSmall">@style/MoagilDialogText</item>
        <item name="android:textAppearanceListItem">@style/MoagilDialogText</item>
        <item name="android:textAppearanceListItemSmall">@style/MoagilDialogText</item>
        <item name="android:listPreferredItemHeightSmall">88dp</item>
        <item name="android:listPreferredItemHeight">88dp</item>
        <item name="android:buttonStyle">@style/MoagilDialogButton</item>
    </style>
    <style name="MoagilDialogTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">#1C1C1E</item>
    </style>
    <style name="MoagilDialogText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">#1C1C1E</item>
    </style>
    <style name="MoagilDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textSize">26sp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textColor">#0066DD</item>
    </style>
</resources>

