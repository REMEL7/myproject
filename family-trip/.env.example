# Copy this file to .env. Keep actual keys out of chat and Git.
# REST key stays on the server; JavaScript key is public and domain-restricted.
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=

# Optional override. If empty, KAKAO_REST_API_KEY is used for car directions too.
# Requires the corresponding Kakao Mobility API access; do not paste keys into chat.
KAKAO_MOBILITY_REST_API_KEY=

# Korea Tourism Organization: Korean tourism information service (KorService2).
# Keep the Decoding service key on the server. Never commit an actual key.
TOUR_API_KEY=

# National parking standard data. Server-only Decoding service key.
PARKING_API_KEY=

# Opt-in only: keep the explicitly bound phone interface open until the server stops.
# start.ps1 -BindAddress <PC-IP> -PublicUrl http://<PC-IP>:8787 -KeepPhoneSharingOpen
PHONE_SHARE_PERSISTENT=0

