# Copy this file to .env. Keep actual keys out of chat and Git.
# REST key stays on the server; JavaScript key is public and domain-restricted.
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=

# Optional override. If empty, KAKAO_REST_API_KEY is used for car directions too.
# Requires the corresponding Kakao Mobility API access; do not paste keys into chat.
KAKAO_MOBILITY_REST_API_KEY=

